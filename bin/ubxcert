#!/usr/bin/env php
<?php

declare(strict_types=1);

// Send every PHP diagnostic to stderr, never stdout. Must run before the
// autoloader is required: PHP 8.5 raises some deprecations at compile time,
// so the first autoloaded class can emit a notice before any command has
// had a chance to configure its own output. In --json mode stdout carries a
// JSON document that consumers parse strictly, and a leading notice breaks
// the parse. Callers redirect stderr to their log, so nothing is lost.
error_reporting(E_ALL);
ini_set('display_errors', 'stderr');
ini_set('log_errors', '0');

// Locate the autoloader — works both from source and when globally installed
$autoloadCandidates = [
    __DIR__ . '/../vendor/autoload.php',      // dev / source run
    __DIR__ . '/../../../autoload.php',        // globally installed in vendor/bin
    '/opt/ubxcert/vendor/autoload.php',        // default global install path
];

$loaded = false;
foreach ($autoloadCandidates as $candidate) {
    if (file_exists($candidate)) {
        require $candidate;
        $loaded = true;
        break;
    }
}

if (!$loaded) {
    fwrite(STDERR, "ubxcert: autoloader not found. Run 'composer install' inside the package directory.\n");
    exit(1);
}

use Ubxty\UbxCert\Application;

$app = new Application();
exit($app->run($argv));
